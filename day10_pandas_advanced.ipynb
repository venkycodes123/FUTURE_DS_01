import pandas as pd
import numpy as np

data = {
    'Name': ['Rahul', 'Anjali', 'Kiran', 'Sneha', 'Arjun'],
    'Age': [20, 21, 19, 22, 20],
    'Marks': [85, 90, 78, 88, 76],
    'Department': ['CSE', 'ECE', 'CSE', 'EEE', 'MECH']
}

df = pd.DataFrame(data)

print(df)

print(df.head())

print(df.tail())

print(df.shape)

print(df.columns)

print(df['Name'])

print(df[['Name', 'Marks']])

print(df[df['Marks'] > 80])

df['Result'] = np.where(df['Marks'] >= 80, 'Pass', 'Fail')

print(df)

group_data = df.groupby('Department')['Marks'].mean()

print(group_data)

sorted_data = df.sort_values(by='Marks', ascending=False)

print(sorted_data)

df.to_csv('day10_output.csv', index=False)

print("Day 10 Task Completed")
