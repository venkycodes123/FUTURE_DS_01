import pandas as pd
import matplotlib.pyplot as plt

data = pd.read_csv("cleaned_student_data.csv")

print(data.head())

plt.scatter(data['MathMarks'], data['Science_Score'])
plt.xlabel("Math Marks")
plt.ylabel("Science Score")
plt.title("Math vs Science")
plt.show()

plt.plot(data['MathMarks'])
plt.title("Math Marks Line Chart")
plt.xlabel("Students")
plt.ylabel("Marks")
plt.show()

data.boxplot(column=['MathMarks'])
plt.title("Math Marks Boxplot")
plt.show()

plt.hist(data['MathMarks'])
plt.title("Math Marks Histogram")
plt.xlabel("Marks")
plt.ylabel("Frequency")
plt.show()

print(data.describe())

print("Day 6 Task Completed")
