import pandas as pd
import matplotlib.pyplot as plt

data = pd.read_csv('student_data2.csv')

print(data.head())

print(data.info())

print(data.describe())

top_students = data.sort_values(by='Marks', ascending=False)

print(top_students.head(5))

data['Department'].value_counts().plot(kind='bar')

plt.title('Students by Department')

plt.xlabel('Department')

plt.ylabel('Count')

plt.show()

data['Marks'].plot(kind='hist')

plt.title('Marks Distribution')

plt.xlabel('Marks')

plt.show()

data.to_csv('eda_student_data.csv', index=False)

print("File Saved Successfully")
