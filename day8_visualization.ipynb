import pandas as pd
import matplotlib.pyplot as plt

data = pd.read_csv('student_data.csv')

print(data.head())

plt.plot(data['Marks'])

plt.title('Student Marks Line Chart')

plt.xlabel('Students')

plt.ylabel('Marks')

plt.show()

data['Department'].value_counts().plot(kind='bar')

plt.title('Department Wise Students')

plt.xlabel('Department')

plt.ylabel('Count')

plt.show()

data['Department'].value_counts().plot(kind='pie', autopct='%1.1f%%')

plt.title('Department Distribution')

plt.ylabel('')

plt.show()

plt.hist(data['Marks'])

plt.title('Marks Histogram')

plt.xlabel('Marks')

plt.ylabel('Frequency')

plt.show()

plt.scatter(data['Age'], data['Marks'])

plt.title('Age vs Marks')

plt.xlabel('Age')

plt.ylabel('Marks')

plt.show()

data.to_csv('visualization_output.csv', index=False)

print("Visualization Task Completed")
