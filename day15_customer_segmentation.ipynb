import pandas as pd
import matplotlib.pyplot as plt

data = pd.read_excel('day15_customer_segmentation.xlsx')

print(data.head())
print(data.tail())

print(data.info())
print(data.isnull().sum())

print("Average Income:", data['Annual_Income'].mean())
print("Maximum Income:", data['Annual_Income'].max())
print("Minimum Income:", data['Annual_Income'].min())

print("Average Spending Score:", data['Spending_Score'].mean())

print(data.nlargest(5, 'Spending_Score')[['Customer_Name', 'Spending_Score']])

print(data.groupby('Gender')['Spending_Score'].mean())

plt.figure(figsize=(8,5))
plt.bar(data['Customer_Name'], data['Spending_Score'])
plt.title('Customer Spending Score')
plt.xticks(rotation=45)
plt.show()

data['Gender'].value_counts().plot.pie(autopct='%1.1f%%')
plt.title('Gender Distribution')
plt.show()

plt.hist(data['Annual_Income'], bins=5)
plt.title('Income Distribution')
plt.xlabel('Annual Income')
plt.show()

plt.scatter(data['Annual_Income'], data['Spending_Score'])
plt.title('Income vs Spending Score')
plt.xlabel('Annual Income')
plt.ylabel('Spending Score')
plt.show()
