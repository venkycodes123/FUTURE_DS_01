import pandas as pd
import matplotlib.pyplot as plt

data = pd.read_excel('day13_student_data.xlsx')

print("First 5 Records")
print(data.head())

print("\nLast 5 Records")
print(data.tail())

print("\nDataset Information")
print(data.info())

print("\nMissing Values")
print(data.isnull().sum())

print("\nAverage Marks")
print(data['Marks'].mean())

print("\nMaximum Marks")
print(data['Marks'].max())

print("\nMinimum Marks")
print(data['Marks'].min())

print("\nAverage Attendance")
print(data['Attendance'].mean())

print("\nTop 3 Students")
print(data.nlargest(3,'Marks')[['Name','Marks']])

plt.figure(figsize=(8,5))
plt.bar(data['Name'],data['Marks'])
plt.title('Student Marks')
plt.xlabel('Students')
plt.ylabel('Marks')
plt.xticks(rotation=45)
plt.show()

department_count = data['Department'].value_counts()
plt.figure(figsize=(6,6))
plt.pie(department_count,labels=department_count.index,autopct='%1.1f%%')
plt.title('Department Distribution')
plt.show()

plt.figure(figsize=(8,5))
plt.hist(data['Marks'],bins=5)
plt.title('Marks Distribution')
plt.xlabel('Marks')
plt.ylabel('Frequency')
plt.show()

plt.figure(figsize=(8,5))
plt.scatter(data['Attendance'],data['Marks'])
plt.title('Attendance vs Marks')
plt.xlabel('Attendance')
plt.ylabel('Marks')
plt.show()
