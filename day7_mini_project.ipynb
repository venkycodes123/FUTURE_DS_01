import pandas as pd
import matplotlib.pyplot as plt

data = pd.read_csv("cleaned_student_data.csv")

print(data.head())

print(data.describe())

print(data.isnull().sum())

top_math = data['MathMarks'].max()
low_math = data['MathMarks'].min()
avg_math = data['MathMarks'].mean()

print("Highest Math Marks:", top_math)
print("Lowest Math Marks:", low_math)
print("Average Math Marks:", avg_math)

top_science = data['Science_Score'].max()
low_science = data['Science_Score'].min()
avg_science = data['Science_Score'].mean()

print("Highest Science Score:", top_science)
print("Lowest Science Score:", low_science)
print("Average Science Score:", avg_science)

data['MathMarks'].plot(kind='bar')
plt.title("Math Marks Bar Chart")
plt.xlabel("Students")
plt.ylabel("Marks")
plt.show()

plt.scatter(data['MathMarks'], data['Science_Score'])
plt.xlabel("Math Marks")
plt.ylabel("Science Score")
plt.title("Math vs Science")
plt.show()

plt.hist(data['English_Score'])
plt.title("English Score Histogram")
plt.xlabel("Marks")
plt.ylabel("Frequency")
plt.show()

print("Mini Project Completed Successfully")
