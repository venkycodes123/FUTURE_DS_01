import pandas as pd
import matplotlib.pyplot as plt

data = pd.read_csv("sales_data.csv")

print("Total Sales:", data["Sales"].sum())
print("Total Profit:", data["Profit"].sum())

category_sales = data.groupby("Category")["Sales"].sum()
region_sales = data.groupby("Region")["Sales"].sum()
product_sales = data.groupby("Product")["Sales"].sum()

plt.figure(figsize=(8,5))
category_sales.plot(kind="bar")
plt.title("Sales by Category")
plt.ylabel("Sales")
plt.show()

plt.figure(figsize=(8,5))
region_sales.plot(kind="pie", autopct="%1.1f%%")
plt.title("Regional Sales Distribution")
plt.ylabel("")
plt.show()

plt.figure(figsize=(10,5))
product_sales.sort_values(ascending=False).plot(kind="bar")
plt.title("Product Wise Sales")
plt.ylabel("Sales")
plt.show()

top_product = product_sales.idxmax()
print("Top Selling Product:", top_product)

profit_margin = (data["Profit"].sum() / data["Sales"].sum()) * 100
print("Profit Margin:", round(profit_margin,2), "%")
